@code {
    private CamshaftProfile currentProfile = new CamshaftProfile();
    private bool isCalculated = false;
    private int animationTrigger = 0;
    private int intakeDuration, exhaustDuration, overlap;
    private double lsa, intakeCenterline, exhaustCenterline;

    private string intakeSvgPath = "", exhaustSvgPath = "", overlapSvgPath = "", exhaustTextPath_CounterClockwise = "";
    private string intakeTextOffset = "50%", exhaustTextOffset = "50%";
    private string? displayProfileName = "", displayProfileNotes = "";

    private bool isArchiveOpen = false;
    private List<CamshaftProfile>? savedProfiles = new List<CamshaftProfile>();

    private string? alertMessage = "";
    private bool isErrorAlert = false;

    // Variabili per il Tema Chiaro/Scuro
    private bool isDarkMode = true;
    private bool isThemeLoaded = false;

    // Variabili per i Popup
    private bool showBetaPopup = false;
    private bool showUpdatePopup = false;
    private string updateMessage = "";
    private string updateUrl = "";
    private bool showSafetyNote = true;

    // La versione attuale dell'app
    private string currentAppVersion = "1.0.0";

    private void DismissSafetyNote()
    {
        Microsoft.Maui.Storage.Preferences.Default.Set("HideSafetyNote", true);
        showSafetyNote = false;
    }

    protected override void OnInitialized()
    {
        // 1. Inizializzazione Deep Link
        DeepLink.OnLinkReceived += HandleDeepLink;
        if (DeepLink.PendingUri != null)
        {
            HandleDeepLink(DeepLink.PendingUri);
            DeepLink.PendingUri = null;
        }

        // 2. Controllo Popup Beta
        if (!Microsoft.Maui.Storage.Preferences.Default.ContainsKey("HasSeenBeta"))
        {
            showBetaPopup = true;
        }

        // 3. Controllo Safety Note
        if (Microsoft.Maui.Storage.Preferences.Default.ContainsKey("HideSafetyNote"))
        {
            showSafetyNote = false;
        }

        // 4. Controllo Aggiornamenti silente
        _ = CheckForUpdatesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedTheme = await JS.InvokeAsync<string>("localStorage.getItem", "themePref");
                if (!string.IsNullOrEmpty(savedTheme))
                {
                    isDarkMode = savedTheme == "dark";
                }
                isThemeLoaded = true;
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "themePref", isDarkMode ? "dark" : "light");
        }
        catch { }
    }

    public void Dispose()
    {
        DeepLink.OnLinkReceived -= HandleDeepLink;
    }

    private async void HandleDeepLink(Uri uri)
    {
        try
        {
            var query = uri.Query.TrimStart('?')
                           .Split('&')
                           .Select(q => q.Split('='))
                           .Where(parts => parts.Length == 2)
                           .ToDictionary(parts => parts[0], parts => Uri.UnescapeDataString(parts[1]));

            await InvokeAsync(async () =>
            {
                currentProfile = new CamshaftProfile
                {
                    Name = "",
                    Notes = "",
                    IntakeOpensBtdc = query.ContainsKey("ino") ? int.Parse(query["ino"]) : null,
                    IntakeClosesAbdc = query.ContainsKey("inc") ? int.Parse(query["inc"]) : null,
                    ExhaustOpensBbdc = query.ContainsKey("exo") ? int.Parse(query["exo"]) : null,
                    ExhaustClosesAtdc = query.ContainsKey("exc") ? int.Parse(query["exc"]) : null
                };

                displayProfileName = query.ContainsKey("n") ? query["n"] : "Shared Profile";
                displayProfileNotes = "Imported via shared link";

                await ExecuteAnalysis();
                StateHasChanged();
            });
        }
        catch (Exception)
        {
            await InvokeAsync(() => ShowAlert("Error: Invalid or corrupted shared link.", true));
        }
    }

    private async Task SafeScrollToTop()
    {
        try { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); } catch { }
    }

    private async Task SafeScrollToBottom()
    {
        try { await Task.Delay(100); await JS.InvokeVoidAsync("eval", "window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });"); } catch { }
    }

    private async Task ExecuteAnalysis()
    {
        if (currentProfile.IntakeOpensBtdc.HasValue && currentProfile.IntakeClosesAbdc.HasValue &&
            currentProfile.ExhaustOpensBbdc.HasValue && currentProfile.ExhaustClosesAtdc.HasValue)
        {
            intakeDuration = Calculator.CalculateIntakeDuration(currentProfile);
            exhaustDuration = Calculator.CalculateExhaustDuration(currentProfile);
            overlap = Calculator.CalculateOverlap(currentProfile);
            lsa = Calculator.CalculateLobeSeparationAngle(currentProfile);
            intakeCenterline = Calculator.CalculateIntakeCenterline(currentProfile);
            exhaustCenterline = Calculator.CalculateExhaustCenterline(currentProfile);

            GenerateVisualDiagram();

            isCalculated = true;
            animationTrigger++;
            await SafeScrollToTop();
        }
    }

    private async Task ClearSession()
    {
        currentProfile = new CamshaftProfile();
        displayProfileName = "";
        displayProfileNotes = "";
        isCalculated = false;
        DismissAlert();
        await SafeScrollToTop();
    }

    private async Task ShareProfile()
    {
        string nameToShare = string.IsNullOrWhiteSpace(displayProfileName) ? "Custom Profile" : displayProfileName;
        string baseUrl = "https://4fundevops.github.io/4FunTimingCalc-web/";
        string queryString = $"?n={Uri.EscapeDataString(nameToShare)}" +
                             $"&ino={currentProfile.IntakeOpensBtdc}" +
                             $"&inc={currentProfile.IntakeClosesAbdc}" +
                             $"&exo={currentProfile.ExhaustOpensBbdc}" +
                             $"&exc={currentProfile.ExhaustClosesAtdc}";

        string fullLink = baseUrl + queryString;
        string shareText = $"4Fun MotorSport TimingCams Calc.\n" +
                           $"Profile Name : \"{nameToShare}\"\n" +
                           $"Durations : IN= {intakeDuration} , EX= {exhaustDuration}\n" +
                           $"Link : {fullLink}\n\n" +
                           $"If you don't have installed the 4Fun Timing Calc APP, please Download it";

        try
        {
            await Microsoft.Maui.ApplicationModel.DataTransfer.Share.RequestAsync(new Microsoft.Maui.ApplicationModel.DataTransfer.ShareTextRequest
            {
                Text = shareText,
                Title = "Share Camshaft Profile"
            });
        }
        catch (Exception ex)
        {
            ShowAlert($"Share error: {ex.Message}", true);
        }
    }

    private void GenerateVisualDiagram()
    {
        double cx = 150, cy = 150;
        double iStart = 360.0 - currentProfile.IntakeOpensBtdc.GetValueOrDefault();
        double eStart = 180.0 - currentProfile.ExhaustOpensBbdc.GetValueOrDefault();

        intakeSvgPath = BuildSvgArc(cx, cy, 100, iStart, iStart + intakeDuration);
        exhaustSvgPath = BuildSvgArc(cx, cy, 80, eStart, eStart + exhaustDuration);
        overlapSvgPath = BuildSvgArc(cx, cy, 120, iStart, 360.0 + currentProfile.ExhaustClosesAtdc.GetValueOrDefault());

        exhaustTextPath_CounterClockwise = BuildCounterClockwiseSvgArc(cx, cy, 80, eStart, eStart + exhaustDuration);

        double iOffsetPct = (currentProfile.IntakeOpensBtdc.GetValueOrDefault() / (double)intakeDuration) * 100.0;
        iOffsetPct = Math.Max(0.1, Math.Min(99.9, iOffsetPct));
        intakeTextOffset = iOffsetPct.ToString(System.Globalization.CultureInfo.InvariantCulture) + "%";

        double eEnd = eStart + exhaustDuration;
        double eOffsetPct = ((eEnd - 180.0) / (double)exhaustDuration) * 100.0;
        eOffsetPct = Math.Max(0.1, Math.Min(99.9, eOffsetPct));
        exhaustTextOffset = eOffsetPct.ToString(System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    private string BuildSvgArc(double x, double y, double r, double startAngleInDegrees, double endAngleInDegrees)
    {
        double diff = endAngleInDegrees - startAngleInDegrees;
        if (diff <= 0) return "";
        var s = PolarToCartesian(x, y, r, startAngleInDegrees);
        var e = PolarToCartesian(x, y, r, endAngleInDegrees);
        var format = System.Globalization.CultureInfo.InvariantCulture;
        return $"M {s.X.ToString(format)} {s.Y.ToString(format)} A {r} {r} 0 {(diff > 180 ? 1 : 0)} 1 {e.X.ToString(format)} {e.Y.ToString(format)}";
    }

    private string BuildCounterClockwiseSvgArc(double x, double y, double r, double startAngleInDegrees, double endAngleInDegrees)
    {
        double diff = endAngleInDegrees - startAngleInDegrees;
        if (diff <= 0) return "";
        var s = PolarToCartesian(x, y, r, endAngleInDegrees);
        var e = PolarToCartesian(x, y, r, startAngleInDegrees);
        var format = System.Globalization.CultureInfo.InvariantCulture;
        return $"M {s.X.ToString(format)} {s.Y.ToString(format)} A {r} {r} 0 {(diff > 180 ? 1 : 0)} 0 {e.X.ToString(format)} {e.Y.ToString(format)}";
    }

    private (double X, double Y) PolarToCartesian(double centerX, double centerY, double radius, double angleInDegrees)
    {
        double angleInRadians = (angleInDegrees - 90.0) * Math.PI / 180.0;
        return (centerX + (radius * Math.Cos(angleInRadians)), centerY + (radius * Math.Sin(angleInRadians)));
    }

    private async Task SaveProfileData()
    {
        var cleanName = currentProfile.Name?.Trim();

        if (string.IsNullOrWhiteSpace(cleanName))
        {
            cleanName = $"Profile {DateTime.Now:HH:mm}";
        }

        var existingProfiles = await Storage.GetAllProfilesAsync();
        var profileList = existingProfiles?.ToList() ?? new List<CamshaftProfile>();

        if (profileList.Any(p => !string.IsNullOrWhiteSpace(p.Name) &&
                                 p.Name.Trim().Equals(cleanName, StringComparison.OrdinalIgnoreCase)))
        {
            ShowAlert("Error: A profile with this name already exists!", true);
            await SafeScrollToBottom();
            return;
        }

        currentProfile.Name = cleanName;
        currentProfile.CreatedAt = DateTime.Now;

        await Storage.SaveProfileAsync(currentProfile);

        displayProfileName = currentProfile.Name;
        displayProfileNotes = currentProfile.Notes;

        currentProfile.Name = "";
        currentProfile.Notes = "";

        ShowAlert("Profile saved successfully!", false);
        await SafeScrollToBottom();
    }

    private void ShowAlert(string message, bool isError)
    {
        alertMessage = message;
        isErrorAlert = isError;
        StateHasChanged();
    }

    private void DismissAlert()
    {
        alertMessage = "";
        StateHasChanged();
    }

    private async Task OpenArchive()
    {
        isArchiveOpen = true;
        savedProfiles = null;
        StateHasChanged();

        var profiles = await Storage.GetAllProfilesAsync();
        savedProfiles = profiles?.ToList() ?? new List<CamshaftProfile>();
    }

    private void CloseArchive()
    {
        isArchiveOpen = false;
    }

    private async Task LoadProfile(CamshaftProfile selectedProfile)
    {
        currentProfile = new CamshaftProfile
        {
            Id = selectedProfile.Id,
            IntakeOpensBtdc = selectedProfile.IntakeOpensBtdc,
            IntakeClosesAbdc = selectedProfile.IntakeClosesAbdc,
            ExhaustOpensBbdc = selectedProfile.ExhaustOpensBbdc,
            ExhaustClosesAtdc = selectedProfile.ExhaustClosesAtdc,
            Name = "",
            Notes = ""
        };

        displayProfileName = selectedProfile.Name;
        displayProfileNotes = selectedProfile.Notes;

        CloseArchive();
        await ExecuteAnalysis();
    }

    protected override async Task OnInitializedAsync()
    {
        DeepLink.OnLinkReceived += HandleDeepLink;
        if (DeepLink.PendingUri != null)
        {
            HandleDeepLink(DeepLink.PendingUri);
            DeepLink.PendingUri = null;
        }

        if (!Microsoft.Maui.Storage.Preferences.Default.ContainsKey("HasSeenBeta"))
        {
            showBetaPopup = true;
        }

        _ = CheckForUpdatesAsync();
    }

    private void CloseBetaPopup()
    {
        Microsoft.Maui.Storage.Preferences.Default.Set("HasSeenBeta", true);
        showBetaPopup = false;
    }

    private async Task CheckForUpdatesAsync()
    {
        try
        {
            using var client = new System.Net.Http.HttpClient();
            client.Timeout = TimeSpan.FromSeconds(5);

            string jsonUrl = "https://4fundevops.github.io/4FunTimingCalc-web/version.json";
            string jsonResponse = await client.GetStringAsync(jsonUrl);

            using var doc = System.Text.Json.JsonDocument.Parse(jsonResponse);
            string latestVersion = doc.RootElement.GetProperty("latestVersion").GetString() ?? "1.0.0";

            if (latestVersion != currentAppVersion)
            {
                updateMessage = doc.RootElement.GetProperty("updateMessage").GetString() ?? "Nuovo aggiornamento!";
                updateUrl = doc.RootElement.GetProperty("storeUrl").GetString() ?? jsonUrl;
                showUpdatePopup = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    private async Task ImportProfile()
    {
        try
        {
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Select a Camshaft Profile backup (.json)"
            });

            if (result == null) return;

            if (!result.FileName.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
            {
                ShowAlert("Please select a valid .json backup file.", true);
                return;
            }

            using var stream = await result.OpenReadAsync();
            using var reader = new StreamReader(stream);
            var jsonContent = await reader.ReadToEndAsync();

            List<CamshaftProfile> profilesToImport = new List<CamshaftProfile>();

            try
            {
                profilesToImport = System.Text.Json.JsonSerializer.Deserialize<List<CamshaftProfile>>(jsonContent) ?? new List<CamshaftProfile>();
            }
            catch
            {
                var singleProfile = System.Text.Json.JsonSerializer.Deserialize<CamshaftProfile>(jsonContent);
                if (singleProfile != null) profilesToImport.Add(singleProfile);
            }

            if (!profilesToImport.Any())
            {
                ShowAlert("Error: Invalid or corrupted backup file.", true);
                return;
            }

            var existingProfiles = await Storage.GetAllProfilesAsync();
            int importCount = 0;

            foreach (var profile in profilesToImport)
            {
                if (string.IsNullOrWhiteSpace(profile.Name)) continue;

                if (existingProfiles.Any(p => p.Name.Trim().Equals(profile.Name.Trim(), StringComparison.OrdinalIgnoreCase)))
                {
                    profile.Name += "_Imported_" + DateTime.Now.ToString("HHmmss");
                }

                await Storage.SaveProfileAsync(profile);
                importCount++;
            }

            var updatedList = await Storage.GetAllProfilesAsync();
            savedProfiles = updatedList?.ToList() ?? new List<CamshaftProfile>();

            ShowAlert($"Successfully imported {importCount} profile(s)!", false);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowAlert($"Import failed: {ex.Message}", true);
        }
    }

    private async Task DeleteProfile(CamshaftProfile profile)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete '{profile.Name}'?");
        if (!confirmed) return;

        try
        {
            await Storage.DeleteProfileAsync(profile.Name);

            var profiles = await Storage.GetAllProfilesAsync();
            savedProfiles = profiles?.ToList() ?? new List<CamshaftProfile>();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowAlert($"Error deleting profile: {ex.Message}", true);
        }
    }

    private async Task ExportProfile(CamshaftProfile profile)
    {
        try
        {
            string json = System.Text.Json.JsonSerializer.Serialize(profile, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });

            string fileName = $"{profile.Name.Replace(" ", "_")}_backup.json";
            string tempFile = Path.Combine(FileSystem.CacheDirectory, fileName);
            await File.WriteAllTextAsync(tempFile, json);

            await Microsoft.Maui.ApplicationModel.DataTransfer.Share.RequestAsync(new Microsoft.Maui.ApplicationModel.DataTransfer.ShareFileRequest
            {
                Title = "Export Camshaft Profile",
                File = new Microsoft.Maui.ApplicationModel.DataTransfer.ShareFile(tempFile)
            });
        }
        catch (Exception ex)
        {
            ShowAlert($"Export failed: {ex.Message}", true);
        }
    }

    private async Task ExportAllProfiles()
    {
        try
        {
            var existingProfiles = await Storage.GetAllProfilesAsync();
            if (existingProfiles == null || !existingProfiles.Any())
            {
                ShowAlert("No profiles to export.", true);
                return;
            }

            string json = System.Text.Json.JsonSerializer.Serialize(existingProfiles, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            string fileName = $"4Fun_GlobalBackup_{DateTime.Now:yyyyMMdd_HHmm}.json";

            using var stream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(json));
            var fileSaverResult = await CommunityToolkit.Maui.Storage.FileSaver.Default.SaveAsync(fileName, stream, default);

            if (fileSaverResult.IsSuccessful)
            {
                ShowAlert("Global backup saved successfully!", false);
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"Export failed: {ex.Message}", true);
        }
    }
