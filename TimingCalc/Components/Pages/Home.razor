    private async Task ExecuteAnalysis()
    {
        if (currentProfile.IntakeOpensBtdc.HasValue && currentProfile.IntakeClosesAbdc.HasValue && 
            currentProfile.ExhaustOpensBbdc.HasValue && currentProfile.ExhaustClosesAtdc.HasValue)
        {
            intakeDuration = Calculator.CalculateIntakeDuration(currentProfile);
            exhaustDuration = Calculator.CalculateExhaustDuration(currentProfile);
            overlap = Calculator.CalculateOverlap(currentProfile);
            lsa = Calculator.CalculateLobeSeparationAngle(currentProfile);
            intakeCenterline = Calculator.CalculateIntakeCenterline(currentProfile);
            exhaustCenterline = Calculator.CalculateExhaustCenterline(currentProfile);

            GenerateVisualDiagram();
            
            isCalculated = true;
            animationTrigger++; 
            await SafeScrollToTop();
        }
    }

