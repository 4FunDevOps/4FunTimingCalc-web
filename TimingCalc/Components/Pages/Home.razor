@* // File: Pages/Home.razor *@
@page "/"
@using TimingCalc.Core.Entities
@using TimingCalc.Core.Interfaces
@using TimingCalc.Core.Services
@using CommunityToolkit.Maui.Storage
@inject ICamshaftCalculatorService Calculator
@inject IStorageService Storage
@inject IJSRuntime JS
@inject DeepLinkStateService DeepLink
@implements IDisposable

<div class="app-container" style="opacity: @(isThemeLoaded ? 1 : 0); transition: opacity 0.3s ease;">

    @* --- OVERLAY POPUP (Beta & Updates) --- *@
    @if (showBetaPopup || showUpdatePopup)
    {
        <div class="archive-modal-overlay" style="z-index: 2000;">
            <div class="archive-modal-content text-center p-4">
                @if (showUpdatePopup)
                {
                    <i class="bi bi-cloud-arrow-down-fill text-primary" style="font-size: 3rem;"></i>
                    <h4 class="mt-3 fw-bold" style="color: #000000 !important;">A new version is available!</h4>
                    <p class="mt-2 mb-2" style="color: #000000 !important; font-weight: 500;">
                        Download it before use the Camshaft Timing Calc App.<br />
                        Visit Socials for new Updates:
                    </p>
                    <div class="d-flex justify-content-center gap-3 my-3">
                        <a href="https://facebook.com/facebook.4funmotorsport" target="_blank" class="text-decoration-none fw-bold" style="color: #1877F2; font-size: 1rem;">
                            <i class="bi bi-facebook me-1" style="font-size: 1.2rem;"></i> Facebook
                        </a>
                        <a href="https://instagram.com/4funmotorsport/" target="_blank" class="text-decoration-none fw-bold" style="color: #E4405F; font-size: 1rem;">
                            <i class="bi bi-instagram me-1" style="font-size: 1.2rem;"></i> Instagram
                        </a>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button class="btn btn-outline-secondary w-50 fw-bold" @onclick="() => showUpdatePopup = false">Later</button>
                        <a href="@updateUrl" target="_blank" class="btn btn-primary w-50 fw-bold">Download Now</a>
                    </div>
                }
                else if (showBetaPopup)
                {
                    <i class="bi bi-tools text-warning" style="font-size: 3rem;"></i>
                    <h4 class="mt-3 fw-bold" style="color: var(--text-main);">Welcome to the Beta!</h4>
                    <p class="mt-2" style="color: var(--text-muted);">This is a test version (Beta). The official version will be released on the stores soon. Your saved profiles will remain safe!</p>
                    <button class="btn btn-warning w-100 fw-bold mt-3 text-dark" @onclick="CloseBetaPopup">Got it</button>
                }
            </div>
        </div>
    }

    @* --- Header Bar --- *@
    <div class="header-bar d-flex justify-content-between align-items-center mb-4 gap-2">
        <div class="d-flex align-items-center gap-2">
            <img src="images/logo_small_header.png" alt="4Fun Logo" style="height: 32px; width: auto;" />
            <h5 class="m-0 fw-bold title-text lh-1" style="font-size: 1.1rem; color: var(--text-main);">4Fun MotorSport<br />Timing Calc</h5>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary flex-shrink-0" style="padding: 6px 12px;" @onclick="ToggleTheme" title="Cambia Tema">
                <i class="bi @(isDarkMode ? "bi-sun-fill text-warning" : "bi-moon-fill text-dark")"></i>
            </button>
            <button class="btn archive-top-btn flex-shrink-0" style="font-size: 0.8rem; padding: 6px 12px;" @onclick="OpenArchive">
                <i class="bi bi-folder2-open"></i> ARCHIVE
            </button>
        </div>
    </div>

    @* --- Area Grafica --- *@
    <div class="graphic-area position-relative mb-3">
        @if (isCalculated)
        {
            <div class="diagram-container d-flex flex-column justify-content-center align-items-center h-100 py-3">
                <div class="badges-container d-flex flex-wrap justify-content-center gap-2 mb-3 px-2">
                    <div class="result-badge badge-intake">INTAKE DUR: @intakeDuration°</div>
                    <div class="result-badge badge-exhaust">EXHAUST DUR: @exhaustDuration°</div>
                    <div class="result-badge badge-overlap">OVERLAP: @overlap°</div>
                    <div class="result-badge badge-lsa">LSA: @lsa.ToString("0.0")°</div>
                    <div class="result-badge badge-intake-cl">INTAKE CL: @intakeCenterline.ToString("0.0")° ATDC</div>
                    <div class="result-badge badge-exhaust-cl">EXHAUST CL: @exhaustCenterline.ToString("0.0")° BTDC</div>
                </div>

                <svg @key="animationTrigger" width="300" height="300" viewBox="0 0 300 300" class="diagram-svg">
                    <defs>
                        <path id="exhaustTextDef" d="@exhaustTextPath_CounterClockwise" />
                    </defs>

                    <line x1="150" y1="20" x2="150" y2="280" stroke="var(--svg-grid)" stroke-width="2" stroke-dasharray="5,5" />
                    <line x1="20" y1="150" x2="280" y2="150" stroke="var(--svg-grid)" stroke-width="2" stroke-dasharray="5,5" />
                    <text x="150" y="15" fill="var(--svg-text)" font-size="12" text-anchor="middle" font-weight="bold">TDC</text>
                    <text x="150" y="295" fill="var(--svg-text)" font-size="12" text-anchor="middle" font-weight="bold">BDC</text>
                    <circle cx="150" cy="150" r="100" stroke="var(--svg-grid)" stroke-width="1" fill="none" />

                    <path id="inletPath" d="@intakeSvgPath" class="animated-path" fill="none" stroke="#4a90e2" stroke-width="12" stroke-linecap="round" />
                    <path d="@exhaustSvgPath" class="animated-path" fill="none" stroke="#e06666" stroke-width="12" stroke-linecap="round" />
                    <path d="@overlapSvgPath" class="animated-path" fill="none" stroke="#f6b26b" stroke-width="6" stroke-linecap="round" />

                    <text fill="#ffffff" font-size="11" font-weight="bold" class="svg-text-label" text-anchor="middle">
                        <textPath href="#inletPath" startOffset="@intakeTextOffset" dy="14">Inlet</textPath>
                    </text>

                    <text fill="#ffffff" font-size="11" font-weight="bold" class="svg-text-label" text-anchor="middle">
                        <textPath href="#exhaustTextDef" startOffset="@exhaustTextOffset" dy="-6">Exhaust</textPath>
                    </text>

                    <circle cx="150" cy="150" r="5" fill="var(--svg-text)" />
                </svg>

                @if (!string.IsNullOrWhiteSpace(displayProfileName))
                {
                    <div class="text-center mt-3 px-3 w-100">
                        <h5 class="fw-bold mb-1" style="letter-spacing: 1px; color: var(--text-main);">@displayProfileName</h5>
                        @if (!string.IsNullOrWhiteSpace(displayProfileNotes))
                        {
                            <p class="small mb-0" style="color: var(--text-muted);">@displayProfileNotes</p>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="diagram-placeholder d-flex flex-column justify-content-center align-items-center h-100 p-4">
                <img src="images/logo_main_placeholder.png" alt="4Fun MotorSport" class="mb-4 fade-in-logo" style="max-width: 180px; height: auto; opacity: 0.9;" />
                <span class="placeholder-text text-center fw-light" style="font-size: 1.2rem; letter-spacing: 1px; color: var(--text-main);">
                    Enter timing values and<br />press Execute
                </span>
            </div>
        }
    </div>

    @* --- Input Dati --- *@
    <div class="inputs-area mb-4">
        <div class="row g-3">
            <div class="col-md-6 col-12">
                <div class="input-group-custom">
                    <label>Intake Opens (BTDC)</label>
                    <input type="number" tabindex="1" @bind="currentProfile.IntakeOpensBtdc" placeholder="--" onfocus="this.select()" />
                </div>
            </div>
            <div class="col-md-6 col-12">
                <div class="input-group-custom">
                    <label>Intake Closes (ABDC)</label>
                    <input type="number" tabindex="2" @bind="currentProfile.IntakeClosesAbdc" placeholder="--" onfocus="this.select()" />
                </div>
            </div>
            <div class="col-md-6 col-12">
                <div class="input-group-custom">
                    <label>Exhaust Opens (BBDC)</label>
                    <input type="number" tabindex="3" @bind="currentProfile.ExhaustOpensBbdc" placeholder="--" onfocus="this.select()" />
                </div>
            </div>
            <div class="col-md-6 col-12">
                <div class="input-group-custom">
                    <label>Exhaust Closes (ATDC)</label>
                    <input type="number" tabindex="4" @bind="currentProfile.ExhaustClosesAtdc" placeholder="--" onfocus="this.select()" />
                </div>
            </div>
        </div>

        @if (isCalculated)
        {
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-outline-info flex-grow-1 fw-bold py-2" tabindex="7" @onclick="ShareProfile">
                    <i class="bi bi-share-fill me-1"></i> SHARE
                </button>
                <button class="btn btn-outline-danger flex-grow-1 fw-bold py-2" tabindex="6" @onclick="ClearSession">
                    <i class="bi bi-trash3-fill me-1"></i> CLEAR
                </button>
                <button class="btn run-btn flex-grow-1 fw-bold py-2 m-0" tabindex="5" style="height: auto;" @onclick="ExecuteAnalysis">
                    <i class="bi bi-arrow-clockwise me-1"></i> RE-CALC
                </button>
            </div>
        }
        else
        {
            <button class="btn w-100 mt-3 fw-bold run-btn" tabindex="5" @onclick="ExecuteAnalysis">
                <i class="bi bi-cpu me-2"></i> EXECUTE ANALYSIS
            </button>
        }

    </div>
</div>

@* --- Salvataggio Dati --- *@
<div class="save-area p-4 rounded mb-4" id="saveArea" style="background-color: var(--bg-save);">
    <h5 class="mb-3" style="color: var(--text-main);">Save Profile Data</h5>
    <div class="row g-3 align-items-center">
        <div class="col-md-4 col-12">
            <input type="text" class="form-control custom-save-input" placeholder="Profile Name" @bind="currentProfile.Name" />
        </div>
        <div class="col-md-6 col-12">
            <input type="text" class="form-control custom-save-input" placeholder="Notes..." @bind="currentProfile.Notes" />
        </div>
        <div class="col-md-2 col-12">
            <button class="btn btn-primary w-100 fw-bold save-btn" @onclick="SaveProfileData" disabled="@(!isCalculated)">SAVE</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert @(isErrorAlert ? "alert-danger" : "alert-success") mt-3 mb-0 py-2 px-3 border-0 fw-bold shadow-sm fade-in-alert"
             style="cursor: pointer;" @onclick="DismissAlert">
            <i class="bi @(isErrorAlert ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>
            @alertMessage <span class="float-end fw-light" style="font-size: 0.8rem;">(Tap to dismiss)</span>
        </div>
    }
</div>

@* --- Sezione Contatti --- *@
<hr class="my-4" style="border-color: var(--border-color); opacity: 0.5;" />

<div class="contacts-section text-center pb-2">
    <h6 class="fw-bold mb-3" style="color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase;">Contact Us</h6>
    <div class="d-flex flex-column align-items-center gap-3">
        <a href="https://facebook.com/facebook.4funmotorsport" target="_blank" class="btn contact-btn w-100 shadow-sm text-start">
            <i class="bi bi-facebook" style="color: #1877F2; font-size: 1.2rem; margin-right: 10px;"></i> Facebook
        </a>
        <a href="https://instagram.com/4funmotorsport/" target="_blank" class="btn contact-btn w-100 shadow-sm text-start">
            <i class="bi bi-instagram" style="color: #E4405F; font-size: 1.2rem; margin-right: 10px;"></i> Instagram
        </a>
        <a href="mailto:info@4funmotorsport.com" class="btn contact-btn w-100 shadow-sm text-start">
            <i class="bi bi-envelope-fill" style="color: #4a90e2; font-size: 1.2rem; margin-right: 10px;"></i> Use eMail
        </a>
    </div>
</div>

@* --- Pannello Archivio File --- *@
@if (isArchiveOpen)
{
    <div class="archive-modal-overlay" @onclick="CloseArchive">
        <div class="archive-modal-content" @onclick:stopPropagation="true">

            @* Intestazione *@
            <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2 border-secondary">
                <h5 class="m-0" style="color: var(--text-main);"><i class="bi bi-folder-fill me-2 text-warning"></i> Saved Profiles</h5>
                <button class="btn btn-sm btn-outline-secondary border-0" style="color: var(--text-main);" @onclick="CloseArchive">
                    <i class="bi bi-x-lg fs-5"></i>
                </button>
            </div>

            @* Messaggio di sicurezza chiudibile *@
            @if (showSafetyNote)
            {
                <div class="alert py-2 px-3 mb-3 border-0 position-relative shadow-sm" style="font-size: 0.8rem; background-color: #fff3cd; color: #664d03; border-radius: 8px;">
                    <button type="button" class="btn-close position-absolute top-0 end-0 p-2" style="font-size: 0.6rem;" aria-label="Close" @onclick="DismissSafetyNote"></button>
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>SAFETY NOTE:</strong> Uninstalling the app will delete all local data. Please <strong>Export All</strong> your profiles to keep a backup.
                    <div class="mt-1 text-end" style="font-size: 0.7rem; text-decoration: underline; cursor: pointer; opacity: 0.8;" @onclick="DismissSafetyNote">
                        Do not show this message again
                    </div>
                </div>
            }

            @* Bottoni Import/Export Globale *@
            <div class="d-flex gap-2 mb-3">
                <button class="btn btn-primary btn-sm flex-grow-1 fw-bold" @onclick="ImportProfile">
                    <i class="bi bi-file-earmark-arrow-up me-2"></i> IMPORT
                </button>
                <button class="btn btn-warning btn-sm flex-grow-1 fw-bold text-dark" @onclick="ExportAllProfiles">
                    <i class="bi bi-file-earmark-zip me-2"></i> EXPORT ALL
                </button>
            </div>

            @* Gestione Stati di Caricamento *@
            @if (savedProfiles == null)
            {
                <div class="text-center py-4" style="color: var(--text-muted);">Loading files...</div>
            }
            else if (savedProfiles.Count == 0)
            {
                <div class="text-center py-4" style="color: var(--text-muted);">No profiles saved yet.</div>
            }
            else
            {
                @* Lista dei Profili *@
                <div class="list-group list-group-flush archive-list">
                    @foreach (var profile in savedProfiles.OrderByDescending(p => p.CreatedAt))
                    {
                        <div class="list-group-item border-secondary p-3 archive-item mb-2">
                            <div class="d-flex justify-content-between align-items-start">

                                @* Area Cliccabile: Carica il profilo *@
                                <div @onclick="() => LoadProfile(profile)" style="flex-grow: 1; cursor: pointer;">
                                    <strong class="fs-5 d-block" style="color: var(--text-main);">@profile.Name</strong>
                                    <small style="color: var(--text-muted); font-size: 0.75rem;">@profile.CreatedAt.ToString("MMM dd, yyyy")</small>

                                    @if (!string.IsNullOrEmpty(profile.Notes))
                                    {
                                        <div class="small mt-1 mb-1 text-truncate" style="max-width: 250px; color: var(--text-muted);">@profile.Notes</div>
                                    }
                                </div>

                                @* Bottoni Azione (Esporta singolo e Elimina) *@
                                <div class="d-flex gap-1 ms-2">
                                    <button class="btn btn-sm btn-outline-info border-0" @onclick="() => ExportProfile(profile)" title="Export Profile">
                                        <i class="bi bi-download"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger border-0" @onclick="() => DeleteProfile(profile)" title="Delete Profile">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </div>

                            @* Badge Dati *@
                            <div class="mt-2 d-flex gap-2 flex-wrap" style="font-size: 0.75rem;">
                                <span class="badge bg-dark border border-secondary text-light">DUR IN: @Calculator.CalculateIntakeDuration(profile)°</span>
                                <span class="badge bg-dark border border-secondary text-light">DUR EX: @Calculator.CalculateExhaustDuration(profile)°</span>
                                <span class="badge bg-dark border border-warning text-warning">OVERLAP: @Calculator.CalculateOverlap(profile)°</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}


<style>
    /* VARIABILI CSS DINAMICHE PER TEMA CHIARO E SCURO (WCAG AAA STANDARD) */
    :root {
        --bg-body: @(isDarkMode ? "#121212" : "#f0f2f5");
        --text-main: @(isDarkMode ? "#f0f0f0" : "#1a1d20");
        --text-muted: @(isDarkMode ? "#c8c8c8" : "#495057");
        --bg-container: @(isDarkMode ? "#1a1a1a" : "#ffffff");
        --bg-graphic: @(isDarkMode ? "#151515" : "#e9ecef");
        --border-color: @(isDarkMode ? "#3d3d3d" : "#ced4da");
        --bg-input-group: @(isDarkMode ? "#222222" : "#f1f3f5");
        --bg-input: @(isDarkMode ? "#111111" : "#ffffff");
        --border-input: @(isDarkMode ? "#555555" : "#adb5bd");
        --bg-save: @(isDarkMode ? "#22252a" : "#e9ecef");
        --svg-grid: @(isDarkMode ? "#555555" : "#adb5bd");
        --svg-text: @(isDarkMode ? "#b0b0b0" : "#343a40");
        --bg-modal: @(isDarkMode ? "#1e1e1e" : "#ffffff");
        --bg-archive-item: @(isDarkMode ? "#252526" : "#ffffff");
        --hover-archive: @(isDarkMode ? "#333333" : "#e2e6ea");
        --bg-contact-btn: @(isDarkMode ? "#222222" : "#ffffff");
        /* Badge Colors Dinamici per la massima accessibilità AAA (7:1) */
        --badge-intake-text: @(isDarkMode ? "#70b0ff" : "#104eab");
        --badge-exhaust-text: @(isDarkMode ? "#ff8080" : "#b91c1c");
        --badge-overlap-text: @(isDarkMode ? "#ffc266" : "#8a4300");
    }

    html, body {
        background-color: var(--bg-body) !important;
        color: var(--text-main);
        font-family: 'Segoe UI', Tahoma, sans-serif;
        overflow-y: auto !important;
        height: auto !important;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    #app {
        background-color: var(--bg-body) !important;
        display: block !important;
        height: auto !important;
        min-height: 100vh;
    }

    .app-container {
        max-width: 900px;
        margin: 10px auto;
        padding: 20px;
        background-color: var(--bg-container);
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.2);
        min-height: 100%;
        display: block;
        transition: background-color 0.3s ease;
    }

    .header-bar {
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 10px;
    }

    .archive-top-btn {
        color: var(--text-main);
        border: 1px solid var(--border-color);
        background-color: transparent;
        transition: 0.2s ease;
    }

        .archive-top-btn:hover {
            background-color: var(--bg-input-group);
            color: var(--text-main);
        }

    .graphic-area {
        min-height: 380px;
        height: auto;
        background-color: var(--bg-graphic);
        border-radius: 8px;
        border: 1px solid var(--border-color);
        margin-bottom: 20px;
    }

    .inputs-area {
        padding-bottom: 20px;
    }

    .input-group-custom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: var(--bg-input-group);
        padding: 12px 20px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        margin-bottom: 5px;
    }

        .input-group-custom label {
            margin: 0;
            color: var(--text-main);
            font-weight: 600;
        }

        .input-group-custom input {
            background-color: var(--bg-input);
            border: 1px solid var(--border-input);
            color: var(--text-main);
            padding: 6px 12px;
            border-radius: 4px;
            width: 90px;
            text-align: center;
            font-weight: bold;
        }

            .input-group-custom input:focus {
                outline: none;
                border-color: #4a90e2;
            }

    .custom-save-input {
        background-color: var(--bg-input) !important;
        color: var(--text-main) !important;
        border: 1px solid var(--border-input) !important;
    }

        .custom-save-input::placeholder {
            color: var(--text-muted);
        }

    .save-btn {
        background-color: #1d4ed8;
        color: #ffffff !important;
        border: none;
        letter-spacing: 1px;
    }

        .save-btn:hover {
            background-color: #1e40af;
        }

    .run-btn {
        height: 50px;
        font-size: 1.1rem;
        letter-spacing: 2px;
        background-color: #212529 !important;
        color: #ffffff !important;
        border: 1px solid #343a40 !important;
        border-radius: 8px;
        transition: 0.15s ease-in-out;
    }

        .run-btn:hover {
            color: #ffffff !important;
            background-color: #343a40 !important;
        }

        .run-btn:focus, .run-btn:focus-visible {
            background-color: #212529 !important;
            color: #ffffff !important;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.6) !important;
            outline: none !important;
        }

        .run-btn:active {
            background-color: #e06666 !important;
            border-color: #e06666 !important;
            transform: scale(0.98);
        }

    .badges-container {
        width: 100%;
        max-width: 800px;
        z-index: 10;
    }

    .result-badge {
        background-color: var(--bg-input);
        padding: 4px 14px;
        border: 1.5px solid;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: bold;
        letter-spacing: 0.5px;
    }

    .badge-intake {
        color: var(--badge-intake-text);
        border-color: var(--badge-intake-text);
    }

    .badge-exhaust {
        color: var(--badge-exhaust-text);
        border-color: var(--badge-exhaust-text);
    }

    .badge-overlap {
        color: var(--badge-overlap-text);
        border-color: var(--badge-overlap-text);
    }

    .badge-lsa {
        color: var(--text-main);
        border-color: var(--border-color);
    }

    .badge-intake-cl {
        color: var(--text-main);
        border-color: var(--badge-intake-text);
    }

    .badge-exhaust-cl {
        color: var(--text-main);
        border-color: var(--badge-exhaust-text);
    }

    .svg-text-label {
        paint-order: stroke fill;
        stroke: #121212;
        stroke-width: 3px;
        stroke-linejoin: round;
        text-shadow: none;
    }

    .contact-btn {
        background-color: var(--bg-contact-btn);
        color: var(--text-main);
        border: 1px solid var(--border-color);
        font-weight: 600;
        transition: 0.2s ease;
    }

        .contact-btn:hover {
            background-color: var(--bg-input-group);
            color: var(--text-main);
        }

    .animated-path {
        stroke-dasharray: 1000;
        stroke-dashoffset: 1000;
        animation: drawPath 2.5s ease-out forwards;
    }

    @@keyframes drawPath {
        to {
            stroke-dashoffset: 0;
        }
